# ResumeMatch Environment Configuration Example
# Copy this file to .env in the backend root for local development.

# --- Backend Configuration (FastAPI / RTJ_*) ---
# Embedding model name (HuggingFace sentence-transformers)
RTJ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Calibration thresholds
RTJ_STRONG_THRESHOLD=0.60
RTJ_PARTIAL_THRESHOLD=0.30
RTJ_EVIDENCE_THRESHOLD=0.35

# CORS Origins (Comma-separated list or '*' for development)
# Example production value: https://your-frontend-domain.vercel.com
RTJ_CORS_ORIGINS=*
